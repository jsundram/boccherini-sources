ionLabel":{"es":["Relaciones"],"pl":["Relacje"],"pt":["Relacionamentos"],"de":["Beziehungen"],"en":["Relations"],"it":["Relazioni"],"fr":["Relations"]},"items":[{"role":{"id":"https://rism.online/vocabulary/relationship/#xp","label":{"es":["Lugar relacionado"],"pl":["Powiązane miejsce"],"pt":["Local relacionado"],"de":["Ort"],"en":["Related place"],"it":["Luogo correlato"],"fr":["Lieu lié"]},"value":"xp"},"relatedTo":{"id":"https://rism.online/places/3902805","label":{"none":["Bergamo, Italia"]},"type":"rism:Place"}}]},"notes":{"id":"https://rism.online/institutions/30001750/notes","label":{"es":["Referencias y notas"],"pl":["Odniesienia i uwagi"],"pt":["Notas e referências"],"de":["Literatur und Bemerkungen"],"en":["References and notes"],"it":["Bibliografia e note"],"fr":["Références et notes"]},"type":"rism:NotesSection","notes":[{"label":{"es":["Historia de la institución"],"pl":["Historia instytucji"],"pt":["História da instituição"],"de":["Geschichte der Körperschaft"],"en":["History of institution"],"it":["Storia dell'ente"],"fr":["Historique de l'institution"]},"value":{"none":["Grazie a una convenzione siglata nel 2006 fra Comune di Bergamo e Fondazione Congregazione Misericordia Maggiore (MÎA) è stata istituita, quale sezione staccata della Biblioteca Civica Angelo Mai (I-BGc), la «Biblioteca Musicale Gaetano Donizetti». In virtù del suo ingente patrimonio, consistente in oltre 30.000 volumi fra manoscritti ed edizioni a stampa, essa rientra nel progetto Polo musicale di Bergamo che si prefigge di concentrare in un’unica gestione i fondi musicali posseduti dagli istituti culturali bergamaschi (Biblioteca Mai, Istituto Musicale, Museo Donizettiano, Teatro Donizetti, Cappella della Basilica di Santa Maria Maggiore), potendo così offrire agli studiosi un servizio il più possibile omogeneo e qualificato.","Dank einer 2006 zwischen der Gemeinde Bergamo und der Fondazione Congregazione Misericordia Maggiore (MIA) unterzeichneten Vereinbarung wurde die \"Biblioteca Musicale Gaetano Donizetti\" als eigenständige Abteilung der Angelo Mai Stadtbibliothek (I-BGc) eingerichtet. Aufgrund ihres riesigen Erbes, das aus über 30.000 Bänden Manuskripten und Druckausgaben besteht, ist es Teil des Projekts Musikzentrum Bergamo, das darauf abzielt, die Musikmittel der Bergamo-Kulturinstitute (Biblioteca Mai, Istituto Musicale, Museo Donizettiano, Teatro Donizetti, Cappella della Basilica di Santa Maria Maggiore) in einer einzigen Verwaltung zu bündeln und den Wissenschaftlern einen möglichst homogenen und qualifizierten Service zu bieten."]}}]},"properties":{"siglum":"I-BGi","countryCodes":["I"],"city":"Bergamo","authorityLinks":[{"id":"https://rism.online/institutions/30001750/external-authorities/isilIT-BG0044","scheme":"isil","identifier":"IT-BG0044"},{"id":"https://rism.online/institutions/30001750/external-authorities/wkpQ16532535","scheme":"wkp","identifier":"Q16532535","uri":"https://www.wikidata.org/wiki/Q16532535"}],"sameAs":["https://www.wikidata.org/wiki/Q16532535"]},"included":[{"id":"rism:Institution","label":{"es":["Institución"],"pl":["Instytucja"],"pt":["Instituição"],"de":["Körperschaft"],"en":["Institution"],"it":["Istituzione"],"fr":["Institution"]}}]}